# All optional. Set in Vercel (build-time) unless noted.
NEXT_PUBLIC_SITE_URL=https://kaeyoung.com
# Search Console HTML-tag verification (content value only)
GOOGLE_SITE_VERIFICATION=
# (eBay Partner Network: campaign 5339155912 is hard-coded in src/lib/affiliate.ts; no variable)
# Amazon Associates tags, one per marketplace program (US/AU fall back to the family's tags)
AMAZON_TAG_US=
AMAZON_TAG_UK=
AMAZON_TAG_CA=
AMAZON_TAG_AU=
AMAZON_TAG_EU=
# Beauty retailer tracking-link templates ({q} = encoded query, {url} = encoded search URL,
# {sub} = our ky-<region>-<placement>-<ean> tag). A retailer's row shows only once set.
AFF_YESSTYLE=
AFF_STYLEVANA=
AFF_OLIVEYOUNG=
AFF_IHERB=
AFF_LOOKFANTASTIC=
AFF_CULTBEAUTY=
# IndexNow key (also a GitHub secret for the daily ping)
INDEXNOW_KEY=
# eBay Marketplace Account Deletion verification token (Vercel, runtime)
EBAY_VERIFICATION_TOKEN=
# GitHub Actions secrets only (never Vercel): eBay Browse API keys, and the
# repository variable EBAY_DAILY_CAP (default and maximum 2,500: the
# keyset is shared with CamCompare)
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# Local development against the fixture instead of data/public:
# KY_DATA_DIR=tests/fixtures/data
